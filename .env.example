# Copy this file to .env and fill in values. Never commit .env.

# Sarvam AI key (optional). Without it, manual order entry still works.
# Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Where the database and temporary audio are stored inside the container.
DATA_DIR=/data

# Hours to keep raw audio if a step fails (minimum 1; audio is deleted as soon as all three texts are ready).
AUDIO_RETENTION_HOURS=24

# Shop timezone used for "today" and date display.
APP_TIMEZONE=Asia/Kolkata
